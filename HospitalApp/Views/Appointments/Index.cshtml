@model IEnumerable<HospitalApp.Models.Appointment>

@{
    ViewData["Title"] = "Записвания";
}

<div class="page-header">
    <h1>Записвания за преглед</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Ново записване</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Все още няма записвания.</div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Date)</th>
                        <th>@Html.DisplayNameFor(model => model.PatientName)</th>
                        <th class="d-none d-sm-table-cell">@Html.DisplayNameFor(model => model.DoctorId)</th>
                        <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.Reason)</th>
                        <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.PatientPhone)</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@item.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-semibold">@item.PatientName</td>
                            <td class="d-none d-sm-table-cell">@item.Doctor?.FullName</td>
                            <td class="d-none d-md-table-cell text-muted">@item.Reason</td>
                            <td class="d-none d-lg-table-cell text-nowrap">@item.PatientPhone</td>
                            <td class="text-end text-nowrap btn-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Детайли"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Редактирай"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Изтрий"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}