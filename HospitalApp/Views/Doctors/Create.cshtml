@model HospitalApp.Models.Doctor

@{
    ViewData["Title"] = "Нов лекар";
}

<h1>Нов лекар</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <partial name="_DoctorFormFields" model="Model" />
            <input type="submit" value="Запиши" class="btn btn-primary" />
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Обратно към списъка</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}