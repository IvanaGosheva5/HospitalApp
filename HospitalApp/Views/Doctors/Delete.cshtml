@model HospitalApp.Models.Doctor

@{
    ViewData["Title"] = "Изтриване на лекар";
    bool hasAppointments = Model.Appointments.Any();
}

<h1>Изтриване на лекар</h1>

@if (hasAppointments)
{
    <div class="alert alert-warning">
        Лекарят има записвания (@Model.Appointments.Count) и не може да бъде изтрит. Първо изтрийте или преместете записванията.
    </div>
}
else
{
    <h3>Сигурни ли сте, че искате да изтриете този лекар?</h3>
}

<table class="table table-striped w-auto">
    <tr>
        <th>Три имена</th>
        <td>@Model.FullName</td>
    </tr>
    <tr>
        <th>Специалност</th>
        <td>@Model.Specialty</td>
    </tr>
    <tr>
        <th>Имейл</th>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <th>Телефон</th>
        <td>@Model.Phone</td>
    </tr>
    <tr>
        <th>Отделение</th>
        <td>@Model.Department?.Name</td>
    </tr>
</table>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Изтрий" class="btn btn-danger" disabled="@hasAppointments" /> |
    <a asp-action="Index">Обратно към списъка</a>
</form>