@model HospitalApp.Models.Doctor

@{
    ViewData["Title"] = "Delete";
}

<h1>Изтрий</h1>

<h3>Сигурни ли сте, че искате да изтриете това?</h3>
<div>
    <h4>HospitalApp.Models.Doctor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
