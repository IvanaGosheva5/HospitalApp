        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Appointments)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" /> |
        <a asp-action="Index">Обратно към списъка</a>
    </form>
