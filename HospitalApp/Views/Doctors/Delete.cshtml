@model HospitalApp.Models.Doctor

@{
    ViewData["Title"] = "Изтриване";
}

<h1>Изтрий</h1>

<h3>Сигурни ли сте, че искате да изтриете този лекар?</h3>
<div>
    <h4>Лекар</h4>
    <hr />
    <table class="table table-striped w-auto">
        <tr>
            <th>Три имена</th>
            <td>@Html.DisplayFor(model => model.FullName)</td>
        </tr>
        <tr>
            <th>Специалност</th>
            <td>@Html.DisplayFor(model => model.Specialty)</td>
        </tr>
        <tr>
            <th>Имейл</th>
            <td>@Html.DisplayFor(model => model.Email)</td>
        </tr>
        <tr>
            <th>Телефон</th>
            <td>@Html.DisplayFor(model => model.Phone)</td>
        </tr>
        <tr>
            <th>Отделение</th>
            <td>@Html.DisplayFor(model => model.Department.Name)</td>
        </tr>
    </table>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" /> |
        <a asp-action="Index">Обратно към списъка</a>
    </form>
</div>