@model IEnumerable<HospitalApp.Models.Doctor>

@{
    ViewData["Title"] = "Лекари";
}

<div class="page-header">
    <h1>Лекари</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Нов лекар</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Все още няма лекари.</div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.FullName)</th>
                        <th class="d-none d-sm-table-cell">@Html.DisplayNameFor(model => model.Specialty)</th>
                        <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.DepartmentId)</th>
                        <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.Email)</th>
                        <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.Phone)</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.FullName</td>
                            <td class="d-none d-sm-table-cell">@item.Specialty</td>
                            <td class="d-none d-md-table-cell">@item.Department?.Name</td>
                            <td class="d-none d-lg-table-cell">@item.Email</td>
                            <td class="d-none d-lg-table-cell text-nowrap">@item.Phone</td>
                            <td class="text-end text-nowrap btn-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Детайли"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Редактирай"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Изтрий"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}