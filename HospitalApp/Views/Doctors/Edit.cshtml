@model HospitalApp.Models.Doctor

@{
    ViewData["Title"] = "Редактиране на лекар";
}

<h1>Редактиране на лекар</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <partial name="_DoctorFormFields" model="Model" />
            <input type="submit" value="Запази" class="btn btn-primary" />
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Обратно към списъка</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}