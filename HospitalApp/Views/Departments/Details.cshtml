@model HospitalApp.Models.Department

@{
    ViewData["Title"] = "Детайли";
}

<h1>Детайли за отделението</h1>

<div>
    <h4>Отделение</h4>
    <hr />
    <table class="table table-striped w-auto">
        <tr>
            <th>Отделение</th>
            <td>@Html.DisplayFor(model => model.Name)</td>
        </tr>
        <tr>
            <th>Описание</th>
            <td>@Html.DisplayFor(model => model.Description)</td>
        </tr>
        <tr>
            <th>Лекари в отделението</th>
            <td>
                @if (Model.Doctors != null && Model.Doctors.Any())
                {
                    @(Model.Doctors.Count)
                    <ul>
                        @foreach (var doc in Model.Doctors)
                        {
                            <li>@doc.FullName (@doc.Specialty)</li>
                        }
                    </ul>
                }
                else
                {
                    <span>Няма назначени лекари</span>
                }
            </td>
        </tr>
    </table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Редактирай</a> |
    <a asp-action="Index">Обратно към списъка</a>
</div>